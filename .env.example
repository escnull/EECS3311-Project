# .env.example - contains no real credentials.
# Copy this file to .env and fill in your own key. .env is git-ignored.

# Which LLM to use: anthropic (Claude), openai (any OpenAI-compatible API), or offline (no LLM, testing only)
LLM_PROVIDER=anthropic
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
LLM_MODEL=claude-haiku-4-5

# Only needed for LLM_PROVIDER=openai, e.g.
#   Groq (free tier):      LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Google Gemini:         LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   Local Ollama:          LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1   (no key needed)
# LLM_BASE_URL=

# Optional tuning
LLM_MAX_TOKENS=2500
LLM_TIMEOUT_SECONDS=90
